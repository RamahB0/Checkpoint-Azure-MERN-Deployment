# Copy this file to .env and fill in real values. Never commit the
# real .env file (it's in .gitignore).

# MongoDB Atlas connection string (Azure has no built-in MongoDB
# service, so the checkpoint has us use MongoDB Atlas instead).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/mern_azure_checkpoint?retryWrites=true&w=majority

# Azure assigns this at runtime - only needed for local development.
PORT=5000
